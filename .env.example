# Copy this file to .env and fill it in:  cp .env.example .env
# Never put a real private key in this file: unlike .env, it is committed to git.

# ===== Required =====

# Address A: the wallet that holds the tokens to sell and signs the order
OWNER_ADDRESS=

# Private key of address A. Used locally for signing only; never share or commit it
PRIVATE_KEY=

# Address B: where the bought tokens are delivered
RECIPIENT=

# ===== Optional (defaults shown) =====

# Chain ID: 1 Ethereum / 8453 Base / 42161 Arbitrum / 100 Gnosis / 137 Polygon / 56 BNB / 43114 Avalanche / 59144 Linea / 11155111 Sepolia
CHAIN_ID=1

# RPC endpoint. Empty uses a public node, which may be rate limited; your own is recommended
RPC_URL=

# Slippage tolerance for market orders and TWAP parts, in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# Market order lifetime in seconds; an unfilled order expires after this.
# Limit orders use --valid instead (default 7d)
VALID_FOR_SECONDS=1800

# How the sell token gets approved for CoW:
#   approve = an on-chain approve transaction (address A needs native currency for gas)
#   permit  = an off-chain signature, fully gasless (EIP-2612 tokens only, e.g. USDC; not USDT or DAI)
APPROVAL_MODE=approve
